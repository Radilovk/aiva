{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aiva",
  "main": "workers/src/index.ts",
  "compatibility_date": "2026-06-02",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "frontend",
    "run_worker_first": ["/api/*"]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "triggers": {
    "crons": ["0 19 * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aiva-db",
      "database_id": "3e660ebf-11b1-47c3-b2c8-752d039dd7dc"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSIONS",
      "id": "d9d04ee275024e2a9cbfcea9da7a13d4"
    }
  ],
  "vars": {
    "MAX_SESSIONS_PER_DAY": "15",
    "MAX_SESSIONS_PER_IP": "40",
    "MAX_PREVIEWS_PER_IP": "10",
    "SUBSCRIPTION_ENFORCED": "false",
    "APP_URL": "https://ai-kasy.online/frontend",
    "STRIPE_PRICE_PLUS_MONTHLY": "",
    "STRIPE_PRICE_PLUS_YEARLY": "",
    "STRIPE_PRICE_PRO_LIFETIME": ""
  },
  "migrations": [
    {
      "tag": "v1",
      "deleted_classes": ["VoiceWebSocket"]
    }
  ]
}
