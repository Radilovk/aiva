{
  "appId": "com.aiva.assistant",
  "appName": "KASY",
  "webDir": "capacitor-shell",
  "server": {
    "androidScheme": "https",
    "hostname": "localhost"
  },
  "plugins": {
    "LocalNotifications": {
      "smallIcon": "ic_stat_aiva",
      "iconColor": "#ff3b5c"
    },
    "SplashScreen": {
      "launchShowDuration": 2000,
      "launchFadeOutDuration": 350,
      "launchAutoHide": true,
      "backgroundColor": "#050508",
      "showSpinner": false,
      "splashFullScreen": true,
      "splashImmersive": true
    }
  },
  "android": {
    "minWebViewVersion": 60,
    "allowMixedContent": false,
    "backgroundColor": "#050508"
  }
}
